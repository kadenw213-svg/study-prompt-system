# Copy to .env and fill in only what you actually use. Nothing here is required
# for the core pipeline (parsing, completeness, reconciliation, preferences) --
# D2L access and Google Calendar writes happen live through Claude Code's own
# browser control and Google Calendar connector, not through this app's own
# network clients. These variables exist for optional/advanced use only.

# Override the default local database location (default: data/academic_sync.db)
ACADEMIC_SYNC_DB_PATH=

# Override the config file path (default: config/default.yaml)
ACADEMIC_SYNC_CONFIG_PATH=

# Optional: only needed if you explicitly enable the LLM-assisted extraction
# adapter (off by default -- see docs/security.md). This is the ONE setting
# that can send course document text to a third party. Leave blank unless you
# have deliberately opted in.
ACADEMIC_SYNC_LLM_API_KEY=

# Optional: institution D2L/Brightspace base URL, e.g. https://yourschool.brightspace.com
# Used only to pre-fill navigation targets for the academic-import skill; never
# used for any automated login or credential submission.
D2L_BASE_URL=

# --- audio-lectures skill (unrelated to the above -- see
# .claude/skills/audio-lectures/SKILL.md) ---

# Override where generated audio/scripts are saved (default: Desktop/Audio Lectures)
AUDIO_LECTURES_OUTPUT_DIR=

# "local" (this machine's GPU) or "remote" (call another PC's TTS server)
AUDIO_LECTURES_TTS_MODE=

# Base URL of a Kokoro-FastAPI-compatible server, only used when TTS_MODE=remote
AUDIO_LECTURES_TTS_SERVER_URL=

# Override the default narrator voice (a Kokoro stock voice id, never a real person's clone)
AUDIO_LECTURES_VOICE_ID=
